// FILE: linked_list.template
// IMPLEMENTS: the linked_list<Item> template class (see linked_list.h).
// This file is included by linked_list.h; do not compile it on its own.

#include <cassert> // Provides assert

namespace alert_service
{
    template <class Item>
    size_t linked_list<Item>::comparisons = 0;
    template <class Item>
    size_t linked_list<Item>::nodes_visited = 0;
    template <class Item>
    size_t linked_list<Item>::allocations = 0;
    template <class Item>
    size_t linked_list<Item>::deallocations = 0;

    template <class Item>
    linked_list<Item>::linked_list()
    {
        head_ptr = NULL;
        tail_ptr = NULL;
        many_nodes = 0;
    }

    template <class Item>
    linked_list<Item>::linked_list(const linked_list &src)
    {
        head_ptr = NULL;
        tail_ptr = NULL;
        many_nodes = 0;
        copy_from(src.head_ptr);
    }

    template <class Item>
    linked_list<Item>::~linked_list()
    {
        clear();
    }

    template <class Item>
    linked_list<Item> &linked_list<Item>::operator=(const linked_list &src)
    {
        // Self-assignment guard: without it, clear would delete src's
        // nodes before copy_from got a chance to read them.
        if (this == &src)
            return *this;

        clear();
        copy_from(src.head_ptr);
        return *this;
    }

    template <class Item>
    void linked_list<Item>::head_insert(const Item &entry)
    {
        head_ptr = new node<Item>(entry, head_ptr);
        ++allocations;
        ++many_nodes;

        if (tail_ptr == NULL)
            tail_ptr = head_ptr;
    }

    template <class Item>
    void linked_list<Item>::insert(node<Item> *previous_ptr, const Item &entry)
    {
        assert(previous_ptr != NULL);

        node<Item> *insert_ptr = new node<Item>(entry, previous_ptr->link());
        ++allocations;
        ++many_nodes;
        previous_ptr->set_link(insert_ptr);

        if (previous_ptr == tail_ptr)
            tail_ptr = insert_ptr;
    }

    template <class Item>
    void linked_list<Item>::head_remove()
    {
        assert(head_ptr != NULL);

        node<Item> *remove_ptr = head_ptr;
        head_ptr = head_ptr->link();
        delete remove_ptr;
        ++deallocations;
        --many_nodes;

        if (head_ptr == NULL)
            tail_ptr = NULL;
    }

    template <class Item>
    void linked_list<Item>::remove(node<Item> *previous_ptr)
    {
        assert(previous_ptr != NULL);
        assert(previous_ptr->link() != NULL);

        node<Item> *remove_ptr = previous_ptr->link();
        previous_ptr->set_link(remove_ptr->link());

        if (remove_ptr == tail_ptr)
            tail_ptr = previous_ptr;

        delete remove_ptr;
        ++deallocations;
        --many_nodes;
    }

    template <class Item>
    void linked_list<Item>::clear()
    {
        while (head_ptr != NULL)
            head_remove();
    }

    template <class Item>
    node<Item> *linked_list<Item>::search(const Item &target)
    {
        for (node<Item> *cursor = head_ptr; cursor != NULL; cursor = cursor->link())
        {
            ++nodes_visited;
            ++comparisons;
            if (target == cursor->data())
                return cursor;
        }

        return NULL;
    }

    template <class Item>
    node<Item> *linked_list<Item>::locate(size_t position)
    {
        assert(0 < position);

        node<Item> *cursor = head_ptr;
        for (size_t i = 1; (i < position) && (cursor != NULL); ++i)
        {
            ++nodes_visited;
            cursor = cursor->link();
        }

        return cursor;
    }

    template <class Item>
    node<Item> *linked_list<Item>::get_head()
    {
        return head_ptr;
    }

    template <class Item>
    node<Item> *linked_list<Item>::get_tail()
    {
        return tail_ptr;
    }

    template <class Item>
    size_t linked_list<Item>::length() const
    {
        return many_nodes;
    }

    template <class Item>
    bool linked_list<Item>::empty() const
    {
        return head_ptr == NULL;
    }

    template <class Item>
    const node<Item> *linked_list<Item>::search(const Item &target) const
    {
        for (const node<Item> *cursor = head_ptr; cursor != NULL; cursor = cursor->link())
        {
            ++nodes_visited;
            ++comparisons;
            if (target == cursor->data())
                return cursor;
        }

        return NULL;
    }

    template <class Item>
    const node<Item> *linked_list<Item>::locate(size_t position) const
    {
        assert(0 < position);

        const node<Item> *cursor = head_ptr;
        for (size_t i = 1; (i < position) && (cursor != NULL); ++i)
        {
            ++nodes_visited;
            cursor = cursor->link();
        }

        return cursor;
    }

    template <class Item>
    const node<Item> *linked_list<Item>::get_head() const
    {
        return head_ptr;
    }

    template <class Item>
    const node<Item> *linked_list<Item>::get_tail() const
    {
        return tail_ptr;
    }

    template <class Item>
    size_t linked_list<Item>::get_comparisons()
    {
        return comparisons;
    }

    template <class Item>
    size_t linked_list<Item>::get_nodes_visited()
    {
        return nodes_visited;
    }

    template <class Item>
    size_t linked_list<Item>::get_allocations()
    {
        return allocations;
    }

    template <class Item>
    size_t linked_list<Item>::get_deallocations()
    {
        return deallocations;
    }

    template <class Item>
    void linked_list<Item>::reset_counters()
    {
        comparisons = 0;
        nodes_visited = 0;
        allocations = 0;
        deallocations = 0;
    }

    template <class Item>
    void linked_list<Item>::print_counters(std::ostream &out)
    {
        out << "linked_list comparisons=" << comparisons
            << " nodes_visited=" << nodes_visited
            << " allocations=" << allocations
            << " deallocations=" << deallocations << std::endl;
    }

    template <class Item>
    void linked_list<Item>::copy_from(const node<Item> *source_ptr)
    {
        if (source_ptr == NULL)
            return;

        // The first node goes in with head_insert; every later node is appended
        // after tail_ptr, which keeps the copy in the same order as the source.
        head_insert(source_ptr->data());
        ++nodes_visited;

        for (source_ptr = source_ptr->link(); source_ptr != NULL; source_ptr = source_ptr->link())
        {
            ++nodes_visited;
            insert(tail_ptr, source_ptr->data());
        }
    }
}
