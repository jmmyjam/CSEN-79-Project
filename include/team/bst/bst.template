// FILE: bst.template
// IMPLEMENTS: the bst<Item> template class (see bst.h).
// This file is included by bst.h; do not compile it on its own.

#include <cassert> // Provides assert

namespace alert_service
{
    template <class Item>
    kit::Counters bst<Item>::counters;

    template <class Item>
    bst<Item>::bst()
    {
        root_ptr = NULL;
        many_nodes = 0;
    }

    template <class Item>
    bst<Item>::bst(const bst &source)
    {
        root_ptr = copy_tree(source.root_ptr);
        many_nodes = source.many_nodes;
    }

    template <class Item>
    bst<Item>::~bst()
    {
        clear_tree(root_ptr);
        many_nodes = 0;
    }

    template <class Item>
    void bst<Item>::insert(const Item &entry)
    {
        binary_tree_node<Item> *cursor = root_ptr;
        bool done = false;

        if (root_ptr == NULL)
        {
            root_ptr = new binary_tree_node<Item>(entry);
            KIT_COUNT(counters, allocations);
            ++many_nodes;
            return;
        }

        do
        {
            KIT_COUNT(counters, visits);
            KIT_COUNT(counters, comparisons);
            if (entry < cursor->data())
            { // Go left

                if (cursor->left() == NULL)
                {
                    cursor->set_left(new binary_tree_node<Item>(entry));
                    KIT_COUNT(counters, allocations);
                    ++many_nodes;
                    done = true;
                }
                else
                    cursor = cursor->left();
            }
            else
            {
                KIT_COUNT(counters, comparisons);
                if (entry > cursor->data())
                { // Go right

                    if (cursor->right() == NULL)
                    {
                        cursor->set_right(new binary_tree_node<Item>(entry));
                        KIT_COUNT(counters, allocations);
                        ++many_nodes;
                        done = true;
                    }
                    else
                        cursor = cursor->right();
                }
                else
                    return; // entry is already in the tree
            }
        } while (!done);
    }

    template <class Item>
    void bst<Item>::remove(const Item &target)
    {
        if (remove_at(root_ptr, target))
            --many_nodes;
    }

    template <class Item>
    void bst<Item>::remove_max()
    {
        assert(!empty());

        Item discarded;
        remove_max_at(root_ptr, discarded);
        --many_nodes;
    }

    template <class Item>
    bst<Item> &bst<Item>::operator=(const bst &source)
    {
        // Self-assignment guard: without it, clear_tree would delete source's
        // nodes before copy_tree got a chance to read them.
        if (this == &source)
            return *this;

        clear_tree(root_ptr);
        root_ptr = copy_tree(source.root_ptr);
        many_nodes = source.many_nodes;
        return *this;
    }

    template <class Item>
    bool bst<Item>::empty() const
    {
        return root_ptr == NULL;
    }

    template <class Item>
    Item bst<Item>::max() const
    {
        assert(!empty());

        const binary_tree_node<Item> *cursor = root_ptr;
        KIT_COUNT(counters, visits);
        while (cursor->right() != NULL)
        {
            cursor = cursor->right();
            KIT_COUNT(counters, visits);
        }
        return cursor->data();
    }

    template <class Item>
    bool bst<Item>::contains(const Item &target) const
    {
        const binary_tree_node<Item> *cursor = root_ptr;

        while (cursor != NULL)
        {
            KIT_COUNT(counters, visits);

            KIT_COUNT(counters, comparisons);
            if (target < cursor->data())
                cursor = cursor->left();
            else
            {
                KIT_COUNT(counters, comparisons);
                if (target > cursor->data())
                    cursor = cursor->right();
                else
                    return true;
            }
        }
        return false;
    }

    template <class Item>
    size_t bst<Item>::size() const
    {
        return many_nodes;
    }

    template <class Item>
    size_t bst<Item>::height() const
    {
        return subtree_height(root_ptr);
    }

    template <class Item>
    void bst<Item>::range(const Item &low, const Item &high, linked_list<Item> &result) const
    {
        // Nodes waiting to be listed once their left side is done. A stack
        // instead of recursion, so a lopsided tree cannot overflow the
        // call stack (see clear_tree).
        linked_list<const binary_tree_node<Item> *> waiting;
        const binary_tree_node<Item> *cursor = root_ptr;

        result.clear();

        while (cursor != NULL || !waiting.empty())
        {
            // Go down to the smallest item that is at least low.
            while (cursor != NULL)
            {
                KIT_COUNT(counters, visits);
                KIT_COUNT(counters, comparisons);
                if (cursor->data() < low)
                    cursor = cursor->right(); // its left subtree is all too small
                else
                {
                    waiting.head_insert(cursor);
                    cursor = cursor->left();
                }
            }

            if (waiting.empty())
             break;

            cursor = waiting.get_head()->data();
            waiting.head_remove();

            KIT_COUNT(counters, comparisons);
            if (!(cursor->data() < high))
             break; // items come out smallest first, so the rest are too big

            if (result.empty())
                result.head_insert(cursor->data());
            else
                result.insert(result.get_tail(), cursor->data());

            cursor = cursor->right();
        }
    }

    template <class Item>
    bool bst<Item>::check_invariants() const
    {
        const Item *previous_ptr = NULL;
        size_t count = 0;

        return check_subtree(root_ptr, previous_ptr, count) && count == many_nodes;
    }


    template <class Item>
    const kit::Counters &bst<Item>::get_counters()
    {
        return counters;
    }

    template <class Item>
    void bst<Item>::reset_counters()
    {
        counters.reset();
    }

    template <class Item>
    void bst<Item>::print_counters(std::ostream &out)
    {
        counters.print(out, "bst");
    }

    template <class Item>
    bool bst<Item>::remove_at(binary_tree_node<Item> *&subtree_ptr, const Item &target)
    {
        binary_tree_node<Item> *oldroot_ptr;

        if (subtree_ptr == NULL)
        { // Empty tree
            return false;
        }

        KIT_COUNT(counters, visits);

        KIT_COUNT(counters, comparisons);
        if (target < subtree_ptr->data())
        { // Continue looking in the left subtree
            return remove_at(subtree_ptr->left(), target);
        }

        KIT_COUNT(counters, comparisons);
        if (target > subtree_ptr->data())
        { // Continue looking in the right subtree
            return remove_at(subtree_ptr->right(), target);
        }

        // Target found
        if (subtree_ptr->left() == NULL)
        { // Target was found and there is no left subtree, so we can
          // remove this node, making the right child be the new root.

            oldroot_ptr = subtree_ptr;
            subtree_ptr = subtree_ptr->right();
            delete oldroot_ptr;
            KIT_COUNT_EXTRA(counters, "deallocations");
            return true;
        }

        // If code reaches this point, then we must remove the target from
        // the current node. We'll actually replace this target with the
        // maximum item of left subtree.
        KIT_COUNT(counters, moves);
        remove_max_at(subtree_ptr->left(), subtree_ptr->data());
        return true;
    }

    template <class Item>
    void bst<Item>::remove_max_at(binary_tree_node<Item> *&subtree_ptr, Item &removed)
    {
        binary_tree_node<Item> *oldroot_ptr;

        assert(subtree_ptr != NULL);
        KIT_COUNT(counters, visits);

        if (subtree_ptr->right() == NULL)
        { // This node is the max. Its left child (or NULL) takes its place.
            removed = subtree_ptr->data();
            oldroot_ptr = subtree_ptr;
            subtree_ptr = subtree_ptr->left();
            delete oldroot_ptr;
            KIT_COUNT_EXTRA(counters, "deallocations");
        }
        else
            remove_max_at(subtree_ptr->right(), removed);
    }

    template <class Item>
    size_t bst<Item>::subtree_height(const binary_tree_node<Item> *subtree_ptr) const
    {
        if (subtree_ptr == NULL)
            return 0;

        size_t left_height = subtree_height(subtree_ptr->left());
        size_t right_height = subtree_height(subtree_ptr->right());

        if (left_height > right_height)
            return 1 + left_height;
        else
            return 1 + right_height;
    }

    template <class Item>
    binary_tree_node<Item> *bst<Item>::copy_tree(const binary_tree_node<Item> *source_ptr)
    {
        binary_tree_node<Item> *l_ptr;
        binary_tree_node<Item> *r_ptr;

        if (source_ptr == NULL)
            return NULL;

        l_ptr = copy_tree(source_ptr->left());
        r_ptr = copy_tree(source_ptr->right());
        KIT_COUNT(counters, allocations);
        return new binary_tree_node<Item>(source_ptr->data(), l_ptr, r_ptr);
    }

    template <class Item>
    void bst<Item>::clear_tree(binary_tree_node<Item> *&subtree_ptr)
    {
        binary_tree_node<Item> *child_ptr;

        // Not recursive: sorted input makes the tree one long chain, and one
        // call per level overflowed the stack at 100,000 nodes under ASan.
        // Turning each left child into its parent's parent leaves a chain
        // that only goes right, which is deleted from the top down.
        while (subtree_ptr != NULL)
        {
            if (subtree_ptr->left() != NULL)
            {
                child_ptr = subtree_ptr->left();
                subtree_ptr->set_left(child_ptr->right());
                child_ptr->set_right(subtree_ptr);
                subtree_ptr = child_ptr;
            }
            else
            {
                child_ptr = subtree_ptr->right();
                delete subtree_ptr;
                KIT_COUNT_EXTRA(counters, "deallocations");
                subtree_ptr = child_ptr;
            }
        }
    }

    template <class Item>
    bool bst<Item>::check_subtree(const binary_tree_node<Item> *subtree_ptr,
                               const Item *&previous_ptr, size_t &count) const
    {
        if (subtree_ptr == NULL)
            return true;

        if (!check_subtree(subtree_ptr->left(), previous_ptr, count))
            return false;

        // Taken in order, a search tree's items must keep getting bigger.
        // Comparing each one only with the item before it is enough to
        // catch a node on the wrong side of any ancestor.
        if (previous_ptr != NULL && !(*previous_ptr < subtree_ptr->data()))
         return false;

        previous_ptr = &subtree_ptr->data();
        ++count;

        return check_subtree(subtree_ptr->right(), previous_ptr, count);
    }

}
